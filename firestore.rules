rules_version = '2';

// Model: anyone may read published posts and submit a contact message.
// Only signed-in admins may write posts or read the inbox.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Only the fields a visitor is allowed to change without being signed in.
    function onlyCounters() {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(['views', 'likes']);
    }

    match /posts/{postId} {
      // Drafts stay private; published posts are public.
      allow get, list: if signedIn() || resource.data.status == 'published';

      allow create, delete: if signedIn();

      // Signed-in admins can edit freely. Visitors may only bump view/like
      // counters on a post that is already published.
      allow update: if signedIn()
        || (resource.data.status == 'published' && onlyCounters());
    }

    match /messages/{messageId} {
      // Anyone can submit the affiliate form.
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'body'])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.body is string
        && request.resource.data.name.size() < 200
        && request.resource.data.email.size() < 200
        && request.resource.data.body.size() < 5000;

      // Reading and managing the inbox is admin-only.
      allow read, update, delete: if signedIn();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
