rules_version = '2';

// Model: anyone may read published posts and submit a contact message.
// Only signed-in admins may write posts or read the inbox.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Only the fields a visitor is allowed to change without being signed in.
    function onlyCounters() {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(['views', 'likes']);
    }

    match /posts/{postId} {
      // Only published posts are public. Drafts and scheduled posts stay
      // private until the admin panel flips them to published.
      //
      // Kept as a plain equality on purpose: Firestore rejects an entire query
      // unless it can prove every document it returns is readable, so a
      // time-based condition here would break the public listing.
      allow get, list: if signedIn() || resource.data.status == 'published';

      allow create, delete: if signedIn();

      // Signed-in admins can edit freely. Visitors may only bump view/like
      // counters, and only on a post that is already published.
      allow update: if signedIn()
        || (resource.data.status == 'published' && onlyCounters());
    }

    match /messages/{messageId} {
      // Anyone can submit the affiliate form.
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'body'])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.body is string
        && request.resource.data.name.size() < 200
        && request.resource.data.email.size() < 200
        && request.resource.data.body.size() < 5000;

      // Reading and managing the inbox is admin-only.
      allow read, update, delete: if signedIn();
    }

    // Chat transcripts.
    //
    // A visitor is not signed in, so they must be able to create their own
    // transcript and append to it. The risk that opens is junk writes, so the
    // shape is pinned down here: required fields, capped sizes, a capped number
    // of messages, and updates limited to the few fields a conversation
    // actually changes. Reading anyone's transcript stays admin-only.
    match /chats/{chatId} {
      function validNewChat() {
        return request.resource.data.keys().hasAll(['name', 'email', 'messages'])
          && request.resource.data.name is string
          && request.resource.data.email is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() < 200
          && request.resource.data.email.size() < 200
          && request.resource.data.messages.size() == 0;
      }

      // Appending a turn touches only these fields, and cannot grow the
      // transcript without bound.
      function validAppend() {
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['messages', 'messageCount', 'lastMessageAt', 'unread'])
          && request.resource.data.messages.size() <= 60
          && request.resource.data.messages.size() > resource.data.messages.size()
          && request.resource.data.name == resource.data.name
          && request.resource.data.email == resource.data.email;
      }

      allow create: if signedIn() || validNewChat();
      allow update: if signedIn() || validAppend();
      allow read, delete: if signedIn();
    }

    match /events/{eventId} {
      // Events are public listings; hidden ones are filtered client-side
      // because a rule condition here would break the collection query.
      allow read: if true;
      allow write: if signedIn();
    }

    // Daily counter documents. Visitors must be able to increment them, so
    // writes are open — but only to documents keyed by date, and reading the
    // figures stays admin-only.
    match /analytics/{day} {
      allow read: if signedIn();
      allow create, update: if day.matches('^\\d{4}-\\d{2}-\\d{2}$');
      allow delete: if signedIn();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
