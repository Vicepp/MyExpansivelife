# Firebase web app credentials.
#
# Copy this file to `.env` and paste in the values from
# Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK setup.
#
# These are browser keys and are safe to expose: access is controlled by the
# Firestore and Storage security rules, not by hiding these values. Add the same
# variables to your Vercel project settings before deploying.
#
# Full walkthrough: docs/FIREBASE.md

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated list of emails allowed to hold an admin session, whichever
# sign-in method they use. STRONGLY RECOMMENDED: without it, anyone who finds
# /admin/login can create an account and publish to your blog.
# e.g. VITE_ADMIN_EMAILS=nkem@myexpansivelife.com,info@phcinvest.com
VITE_ADMIN_EMAILS=
