# Firebase web app credentials.
#
# Copy this file to `.env` and paste in the values from
# Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK setup.
#
# These are browser keys and are safe to expose: access is controlled by the
# Firestore and Storage security rules, not by hiding these values. Add the same
# variables to your Vercel project settings before deploying.
#
# Full walkthrough: docs/FIREBASE.md

VITE_FIREBASE_API_KEY= AIzaSyBFpDmL1Klz8abErGy3bWPHjSlB-vFVsgI
VITE_FIREBASE_AUTH_DOMAIN= myexpansivelife-a8bec.firebaseapp.com
VITE_FIREBASE_PROJECT_ID= myexpansivelife-a8bec
VITE_FIREBASE_STORAGE_BUCKET= myexpansivelife-a8bec.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID= 461500805441
VITE_FIREBASE_APP_ID= 1:461500805441:web:7f46d8bc87bbf4ed59b1c0
VITE_MEASUREMENT_ID= G-FV7L1SJDLT

# Comma-separated list of emails allowed to hold an admin session, whichever
# sign-in method they use. STRONGLY RECOMMENDED: without it, anyone who finds
# /admin/login can create an account and publish to your blog.
# e.g. VITE_ADMIN_EMAILS=nkem@myexpansivelife.com,info@phcinvest.com
VITE_ADMIN_EMAILS= info@phcinvest.com,nkem@phcinvest.com,chris@phcinvest.com,famimi@phcinvest.com,isaiah@phcinvest.com,grace@phcinvest.com,glory@phcinvest.com,adetutu@phcinvest.com



# ---------------------------------------------------------------------------
# Cloudinary — image hosting for article images and covers.
#
# Free tier: 25 GB storage + 25 GB bandwidth a month. Uploads go straight from
# the browser using an UNSIGNED preset, so there is no API secret here.
# Setup walkthrough: docs/CLOUDINARY.md
# ---------------------------------------------------------------------------

# From the Cloudinary dashboard (not your email/username), e.g. dxy123abc
VITE_CLOUDINARY_CLOUD_NAME= vouu3rrk

# Settings -> Upload -> Upload presets -> Add, with Signing mode = Unsigned
VITE_CLOUDINARY_UPLOAD_PRESET= My Expansive Life

# Optional. Defaults to mxl/posts.
VITE_CLOUDINARY_FOLDER=mxl/posts


# ---------------------------------------------------------------------------
# AI chat assistant — OpenRouter.
#
# NOTE THE MISSING VITE_ PREFIX. That is deliberate. Vite inlines every
# VITE_-prefixed variable into the public JavaScript bundle, so a VITE_ key
# would be readable by any visitor and could be used to drain your credit.
# Without the prefix it stays server-side, read only by the Netlify Function
# in netlify/functions/chat.js.
#
# On Netlify: Site configuration -> Environment variables. Add these as plain
# variables (not VITE_ ones) and redeploy.
# ---------------------------------------------------------------------------

OPENROUTER_API_KEY=

# Optional. Tried first; falls back to the free models below if it is
# unavailable, out of credit or rate-limited. Defaults to anthropic/claude-3.5-haiku.
OPENROUTER_MODEL=

# Optional, comma separated. To run entirely free, set OPENROUTER_MODEL to a
# model ending in ":free".
OPENROUTER_FALLBACK_MODELS=

# Optional. A Calendly-style booking link for the assistant to share. Left
# blank, it offers an email follow-up rather than inventing a booking page.
CHAT_BOOKING_URL=
