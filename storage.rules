rules_version = '2';

// Post images are publicly readable so they render on the live blog.
// Only signed-in admins may upload, and only images up to 5 MB.
service firebase.storage {
  match /b/{bucket}/o {
    match /posts/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
