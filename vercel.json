{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/join",
      "destination": "https://community.myexpansivelife.com/c/join-the-community-957bfc",
      "permanent": false
    },
    {
      "source": "/c/:path*",
      "destination": "https://community.myexpansivelife.com/c/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/rebuild.js": {
      "maxDuration": 20
    }
  }
}
